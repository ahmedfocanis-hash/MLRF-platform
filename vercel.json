{
  "version": 2,
  "builds": [
    { "src": "apps/api/src/server.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "apps/web/dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/src/server.ts" },
    { "src": "/login", "dest": "apps/web/dist/index.html" },
    { "src": "/(.*)", "dest": "apps/web/dist/$1" }
  ]
}
