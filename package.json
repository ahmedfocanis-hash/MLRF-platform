{
  "name": "medical-liability-risk-fund-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "postinstall": "chmod -R +x node_modules/.bin || true",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint --workspaces --if-present && npm run typecheck --workspaces --if-present && npm test --workspaces --if-present",
    "seed": "npm --workspace apps/api run seed",
    "seed:reset": "npm --workspace apps/api run seed:reset",
    "sample:bank-sheet": "npm --workspace apps/api run sample:bank-sheet",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
